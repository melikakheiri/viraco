PORT=3001
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=taskboard
DATABASE_USER=taskboard
DATABASE_PASSWORD=REPLACE_WITH_YOUR_LOCAL_DATABASE_PASSWORD

# Development-only seed accounts. Never use these passwords in production.
SEED_OWNER_EMAIL=owner@taskboard.local
SEED_OWNER_PASSWORD=REPLACE_WITH_YOUR_OWNER_PASSWORD
SEED_MANAGER_EMAIL=manager@taskboard.local
SEED_MANAGER_PASSWORD=REPLACE_WITH_YOUR_MANAGER_PASSWORD
SEED_MEMBER_EMAIL=member@taskboard.local
SEED_MEMBER_PASSWORD=REPLACE_WITH_YOUR_MEMBER_PASSWORD

# Authentication: generate JWT_ACCESS_SECRET with crypto.randomBytes(48).toString("base64url").
JWT_ACCESS_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_ISSUER=taskboard-backend
JWT_AUDIENCE=taskboard-browser
JWT_ACCESS_TTL_SECONDS=300
REFRESH_TTL_SECONDS=604800
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ACCESS_COOKIE_NAME=tb_access
REFRESH_COOKIE_NAME=tb_refresh
