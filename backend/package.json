{
  "name": "backend",
  "private": true,
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "migration:run": "ts-node src/database/migrate-cli.ts",
    "migration:generate": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:generate",
    "seed": "ts-node src/database/seed-cli.ts",
    "test:database": "ts-node src/database/database.test.ts",
    "migration:show": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:show",
    "test:auth": "ts-node src/auth/auth.test.ts",
    "test": "npm run test:contracts && npm run test:database && npm run test:auth && npm run test:rbac && npm run test:tasks",
    "test:contracts": "ts-node src/contracts.test.ts",
    "test:rbac": "ts-node src/users/users.test.ts",
    "test:tasks": "ts-node src/tasks/tasks.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.3",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.3",
    "@nestjs/platform-express": "^11.0.3",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "eslint": "^9.39.5",
    "ts-node": "^10.9.2",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.0"
  }
}
